{
  "name": "sandwich",
  "productName": "Sandwich",
  "version": "0.1.0",
  "description": "TikTok Shop UGC auto-editor: before clip, after clip, product b-roll.",
  "main": ".vite/build/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-forge start",
    "studio": "remotion studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && tsc --noEmit",
    "format": "prettier --write .",
    "make": "electron-forge package",
    "package": "electron-forge package",
    "fixtures": "node -e \"console.error('fixtures: not implemented until step 0.3'); process.exit(1)\"",
    "render:sample": "node -e \"console.error('render:sample: not implemented until step 0.4'); process.exit(1)\"",
    "verify:render": "node -e \"console.error('verify:render: not implemented until step 1.5'); process.exit(1)\"",
    "postinstall": "tsx scripts/ffmpeg-fetch.ts --postinstall",
    "ffmpeg:fetch": "tsx scripts/ffmpeg-fetch.ts",
    "ffmpeg:check": "tsx scripts/ffmpeg-check.ts",
    "probe": "tsx scripts/probe.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.535",
    "@remotion/cli": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.535",
    "scheduler": "0.27.0",
    "ws": "8.21.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "optionalDependencies": {
    "@remotion/compositor-darwin-arm64": "4.0.535",
    "@remotion/compositor-darwin-x64": "4.0.535",
    "@remotion/compositor-linux-arm64-gnu": "4.0.535",
    "@remotion/compositor-linux-arm64-musl": "4.0.535",
    "@remotion/compositor-linux-x64-gnu": "4.0.535",
    "@remotion/compositor-linux-x64-musl": "4.0.535",
    "@remotion/compositor-win32-x64-msvc": "4.0.535"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.1",
    "@electron-forge/plugin-vite": "7.11.1",
    "@playwright/test": "^1.64.1",
    "@remotion/eslint-config-flat": "4.0.535",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.20.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/web": "0.0.166",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "40.10.2",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
